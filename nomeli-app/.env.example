# Copy this file to .env and fill in a real Supabase project to connect
# one — the app runs entirely on local on-device storage without it.
# Expo inlines any EXPO_PUBLIC_* variable into the client bundle at build
# time, so these are safe to expose (use the anon key, never the service
# role key).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
